PORT=3999
NODE_ENV=production
BASE_URL=http://localhost:3999

JWT_SECRET=

ADMIN_USERNAME=
ADMIN_PASSWORD=

MAX_UPLOAD_SIZE=10485760
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

STORAGE_ROOT_DIR=/var/lib/storage-api
STORAGE_DIR=/var/lib/storage-api/storage
APPS_STORAGE_DIR=/var/lib/storage-api/storage/apps
DATA_DIR=/var/lib/storage-api/data
DB_DIR=/var/lib/storage-api/db
TMP_DIR=/var/lib/storage-api/tmp

